{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLIMEdit",
  "version": "0.1.0",
  "identifier": "io.okita.llimedit",
  "build": {
    "beforeDevCommand": "bash scripts/dev-server.sh",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LLIMEdit",
        "url": "index.html",
        "width": 1600,
        "height": 1200,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": [30, 30, 30, 255]
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "licenseFile": "../LICENSE",
    "shortDescription": "LLIMEdit: a minimal cross-platform plain-text editor with LM Studio integration.",
    "longDescription": "LLIMEdit is a single-window plain-text editor that integrates with a local LM Studio (or compatible OpenAI /v1/chat/completions) endpoint. Distributed under the MIT License.",
    "publisher": "okita.io",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
